# ===== Vertex AR — Production Environment TEMPLATE =====
#
# This is a TEMPLATE. Copy it to `.env` on the server and fill in real values:
#     cp .env.production.example .env
#
# NEVER commit a real `.env` / `.env.production` — they are git-ignored.
# Values marked CHANGE_ME must be replaced before going live.

# --- Environment ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://vertex_ar:CHANGE_ME_DB_PASSWORD@localhost:5432/vertex_ar

# --- Security (CHANGE THESE!) ---
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# Dedicated secrets — set each separately so one leak does not compromise all.
SESSION_SECRET_KEY=CHANGE_ME_SESSION_SECRET
TOKEN_ENCRYPTION_KEY=CHANGE_ME_TOKEN_ENCRYPTION_SECRET
MEDIA_URL_SECRET=CHANGE_ME_MEDIA_URL_SECRET
# Legacy unsalted SHA-256 hashes are always rejected in production regardless
# of this value. Leave false.
ALLOW_LEGACY_PASSWORD_HASHES=false

ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@vertexar.com

# --- Public URL (your domain with HTTPS via Nginx) ---
PUBLIC_URL=https://ar.neuroimagen.ru

# --- SSL: handled by Nginx, not needed here ---
SSL_KEYFILE=
SSL_CERTFILE=

# --- CORS ---
CORS_ORIGINS=https://ar.neuroimagen.ru

# --- Storage (persistent directory on server) ---
STORAGE_BASE_PATH=/opt/arv/storage
LOCAL_STORAGE_PATH=/opt/arv/storage
LOCAL_STORAGE_PUBLIC_URL=https://ar.neuroimagen.ru/storage

# --- Redis ---
# Include the password: redis://:<password>@host:6379/0
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# --- Docker Compose (only needed when using docker-compose.yml) ---
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Android App Links ---
ANDROID_APP_PACKAGE=ru.neuroimagen.arviewer
ANDROID_APP_SHA256_FINGERPRINTS=

# --- App store links for /view/{unique_id} landing page ---
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=ru.neuroimagen.arviewer
APP_STORE_URL=
RUSTORE_URL=
APP_GALLERY_URL=https://appgallery.huawei.com/#/app/C117404839

# --- Monitoring (optional) ---
SENTRY_DSN=
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
