# ─── Database ───────────────────────────────────────────────
# SQLite for local development:
DATABASE_URL=sqlite+aiosqlite:///./vertex_ar.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://vertex_ar:REPLACE_WITH_SECURE_PASSWORD@localhost:5432/vertex_ar

# ─── Security ──────────────────────────────────────────────
# REQUIRED in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY_MIN_32_CHARS

# Dedicated secrets. Each falls back to SECRET_KEY when unset, but you SHOULD
# set them separately so leaking one secret does not compromise the others.
# Generate each with `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
#   SESSION_SECRET_KEY   — signs browser session cookies (SessionMiddleware)
#   TOKEN_ENCRYPTION_KEY — derives the Fernet key that encrypts stored OAuth tokens
#   MEDIA_URL_SECRET     — signs Yandex Disk proxy URLs (/storage/...?exp=..&sig=..)
SESSION_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
MEDIA_URL_SECRET=

# Accept legacy unsalted SHA-256 password hashes during migration.
# Ignored (always disabled) when ENVIRONMENT=production. Keep false unless you
# are actively migrating an old database.
ALLOW_LEGACY_PASSWORD_HASHES=false

# Admin credentials (created on first startup)
# WARNING: Replace with a strong production password via environment variable.
ADMIN_DEFAULT_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ─── Public URL ────────────────────────────────────────────
# Used for QR codes, AR links, App Links. No trailing slash.
PUBLIC_URL=http://localhost:8000

# App store links for /view/{unique_id} landing page
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=ru.neuroimagen.arviewer
APP_STORE_URL=
RUSTORE_URL=
APP_GALLERY_URL=https://appgallery.huawei.com/#/app/C117404839

# ─── SSL (optional) ────────────────────────────────────────
# SSL_KEYFILE=ssl/privkey.pem
# SSL_CERTFILE=ssl/fullchain.pem

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated origins (optional, sensible defaults built-in)
# CORS_ORIGINS=https://your-domain.com,http://localhost:8000

# ─── Storage ──────────────────────────────────────────────
MEDIA_ROOT=/app/storage/content

# ─── Yandex OAuth (for Yandex Disk storage) ───────────────
# Register app at https://oauth.yandex.ru/ to get these values
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# ─── Redis (optional, for caching) ────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─── Docker Compose (docker-compose.yml) ──────────────────
# REQUIRED for `docker compose up` — the compose file refuses to start without
# these (no insecure defaults). Use strong random values.
# POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ─── Monitoring (optional) ────────────────────────────────
# SENTRY_DSN=

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Environment ──────────────────────────────────────────
# Set to "production" on real server
ENVIRONMENT=development
