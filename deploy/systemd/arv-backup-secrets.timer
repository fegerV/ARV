[Unit]
Description=ARV secrets backup timer (weekly, Sunday 04:00 UTC)

[Timer]
# Weekly rather than daily: .env and the TLS material change only on deployment
# or certificate renewal, and each archive is a full copy (no deduplication).
OnCalendar=Sun *-*-* 04:00:00
Persistent=true
RandomizedDelaySec=600
AccuracySec=1min
Unit=arv-backup-secrets.service

[Install]
WantedBy=timers.target
