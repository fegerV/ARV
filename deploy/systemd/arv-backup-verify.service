[Unit]
Description=ARV backup integrity verification (checksum + pg_restore --list)
Documentation=file:/opt/arv/app/docs/BACKUP_AND_RECOVERY.md
After=network-online.target
Wants=network-online.target
OnFailure=arv-backup-alert@%n.service

[Service]
Type=oneshot
User=arv
Group=arv
WorkingDirectory=/opt/arv/app
EnvironmentFile=/opt/arv/app/.env
ExecStart=/opt/arv/app/deploy/backup/verify.sh
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arv-backup-verify

[Install]
WantedBy=multi-user.target
