[Unit]
Description=ARV secrets and configuration backup (class A3)
Documentation=file:/opt/arv/app/docs/BACKUP_AND_RECOVERY.md
After=network-online.target
Wants=network-online.target
OnFailure=arv-backup-alert@%n.service

[Service]
Type=oneshot
User=arv
Group=arv
WorkingDirectory=/opt/arv/app
EnvironmentFile=/opt/arv/app/.env
ExecStart=/opt/arv/app/deploy/backup/backup-secrets.sh
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arv-backup-secrets

[Install]
WantedBy=multi-user.target
