# Test environment configuration.
#
# Committed on purpose: it holds no real credentials, and without it in the repo
# a checkout can only run the suite against its own live .env. That made test
# outcomes depend on how the deployment happened to be configured — enabling
# dump encryption on prod was enough to break an assertion about the uploaded
# artifact's suffix.
#
# Every value here is a dummy. Run the suite with:
#   bash scripts/run_tests.sh -q
DATABASE_URL=sqlite+aiosqlite:///./test_vertex_ar.db
SECRET_KEY=test-secret-key-for-development-min-32-chars-long
ADMIN_DEFAULT_PASSWORD=admin123
ENVIRONMENT=development
DEBUG=true
PUBLIC_URL=http://localhost:8000
MEDIA_ROOT=./storage/content
TEMPLATES_DIR=./templates
STATIC_DIR=./static
STORAGE_BASE_PATH=./storage
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000/storage
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# --- backup / DR: pinned so the suite does not inherit the live deployment ---
# Process environment variables win over `.env` in pydantic-settings, so setting
# these explicitly (even empty) neutralises whatever the host has configured.
# Without this the backup tests silently change behaviour when encryption,
# media snapshots or a secondary target are switched on in production.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_BINARY=age
BACKUP_AGE_IDENTITY_FILE=
BACKUP_SECONDARY_RCLONE_REMOTE=
BACKUP_HEARTBEAT_URL=
BACKUP_MEDIA_ENABLED=false
BACKUP_RESTIC_BINARY=restic
BACKUP_RESTIC_REPOSITORY=
BACKUP_RESTIC_PASSWORD_FILE=
BACKUP_MEDIA_PATHS=
BACKUP_STAGING_DIR=./.pytest-temp/backups
BACKUP_MAX_AGE_HOURS=26
BACKUP_SECRETS_MAX_AGE_HOURS=192
BACKUP_DRILL_MAX_AGE_DAYS=31
