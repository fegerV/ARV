# Logs
*.log

# Environment
.env
.env.local
.env.production
*.env.*
# ...but keep the committed templates
!.env.example
!.env.production.example
# ...and the test environment: it holds no real credentials, and without it in
# the repo a checkout can only run the suite against its own live .env, which
# makes the outcome depend on how the deployment happens to be configured.
!.env.test

# Coverage
.coverage
coverage.xml
htmlcov/
coverage/

# Alemic - keep migration .py files tracked, ignore compiled files
alembic/versions/*.pyc

# Temporary files
*.tmp
*~
.DS_Store
Thumbs.db

