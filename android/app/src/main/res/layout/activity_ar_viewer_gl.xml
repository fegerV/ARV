<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.opengl.GLSurfaceView
        android:id="@+id/ar_gl_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextureView
        android:id="@+id/floating_video_overlay"
        android:layout_width="280dp"
        android:layout_height="158dp"
        android:layout_gravity="center"
        android:alpha="1"
        android:keepScreenOn="true"
        android:visibility="gone" />

    <Button
        android:id="@+id/button_ar_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ar_gl_control_button_background"
        android:contentDescription="@string/ar_error_go_back"
        android:text="‹"
        android:textColor="@android:color/white"
        android:textSize="32sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_capture_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ar_gl_control_button_background"
            android:text="@string/capture_photo"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/button_record_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ar_gl_control_button_background"
            android:text="@string/record_video"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/button_record_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ar_gl_control_button_background"
            android:text="@string/record_quality_hd30"
            android:textColor="@android:color/white" />

    </LinearLayout>
</FrameLayout>
